{
  "compilerOptions": {
    "rootDir": "TS-03/src",
    "outDir": "TS-03/dist",

    "module": "esnext",
    "target": "esnext",
    
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["TS-03/src/**/*"]
}